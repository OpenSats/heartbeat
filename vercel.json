{
  "functions": {
    "api/pow/source.ts": {
      "maxDuration": 60
    },
    "api/pow/github-worker.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "pow-github",
          "maxConcurrency": 1,
          "retryAfterSeconds": 60
        }
      ]
    },
    "api/pow/nostr-worker.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "pow-nostr",
          "maxConcurrency": 2,
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/pow",
      "destination": "/index.html"
    },
    {
      "source": "/pow/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pow/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
